{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"rewriteRelativeImportExtensions": false,
		"skipLibCheck": true,
		"sourceMap": true,
		"moduleResolution": "bundler",
		"strict": true
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"playwright.config.ts",
		"playwright.env.ts",
		"src/typescript/**/*.d.ts",
		"src/**/*.e2e.js",
		"src/**/*.e2e.ts",
		"src/routes/api/e2e/**/*.ts",
		"tests/**/*.js",
		"tests/**/*.ts"
	],
	"exclude": [
		"node_modules/**",
		"src/routes/demo/**",
		"src/schema_/**",
		"src/views_/**",
		"src/views__/**",
		"src/routes_/**",
		"src/sources_/**",
		"src/resolvers_/**",
		"src/**/*.test.js",
		"src/**/*.test.ts",
		"src/**/*.spec.js",
		"src/**/*.spec.ts"
	]
}
