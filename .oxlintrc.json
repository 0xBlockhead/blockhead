{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"jsPlugins": [
		"./scripts/lint/oxlint-plugin-no-runtime-shape-guards.mjs"
	],
	"plugins": [
		"typescript"
	],
	"categories": {
		"correctness": "off",
		"nursery": "off",
		"pedantic": "off",
		"perf": "off",
		"restriction": "off",
		"style": "off",
		"suspicious": "off"
	},
	"options": {
		"typeAware": false
	},
	"ignorePatterns": [
		"**/node_modules/**",
		".worktrees/**",
		".svelte-kit/**",
		"build/**",
		"dist/**",
		"coverage/**",
		"playwright-report/**",
		"docs/architecture/blockhead/vendor/msagl-1.1.26.bundle.js",
		"src/routes/demo/**",
		"**/*.d.ts",
		"scripts/**/*.ts"
	],
	"rules": {
		"no-restricted-globals": [
			"error",
			{
				"name": "Reflect",
				"message": "Avoid Reflect except when forwarding Proxy traps; use normal property access or Object.getOwnPropertyDescriptor."
			}
		],
		"typescript/consistent-type-assertions": [
			"error",
			{
				"assertionStyle": "never"
			}
		],
		"typescript/no-inferrable-types": "error",
		"typescript/no-unnecessary-condition": "error",
		"typescript/no-unnecessary-type-assertion": "error",
		"typescript/no-restricted-types": [
			"error",
			{
				"types": {
					"unknown": "Prefer JsonValue ($/typescript/JsonValue.ts), explicit domain types, or a documented exception (EIP-1193, error serialization, Promise rejection)."
				}
			}
		],
		"no-runtime-shape-guards/guards": "error"
	},
	"overrides": [
		{
			"files": ["src/schema/**/*.ts"],
			"rules": {
				"typescript/consistent-type-assertions": "off"
			}
		},
		{
			"files": [
				"src/schema/$schema.ts"
			],
			"rules": {
				"typescript/no-restricted-types": "off",
				"no-runtime-shape-guards/guards": "off"
			}
		},
		{
			"files": [
				"src/client/$client.svelte.ts",
				"src/collections/$queries.svelte.ts",
				"src/collections/entityQuerySynthesis.ts",
				"src/collections/assertLoadedCollectionRows.ts"
			],
			"rules": {
				"typescript/consistent-type-assertions": "off",
				"typescript/no-restricted-types": "off"
			}
		},
		{
			"files": [
				"src/sources/**/*.ts",
				"src/resolvers/**/*.ts"
			],
			"rules": {
				"typescript/consistent-type-assertions": "off",
				"typescript/no-restricted-types": "off"
			}
		},
		{
			"files": [
				"tests/e2e/wallet-extensions/**/*.e2e.ts"
			],
			"rules": {
				"no-restricted-globals": "off",
				"typescript/no-restricted-types": "off"
			}
		},
		{
			"files": [
				"src/lib/db/browserPersistenceRuntime.ts"
			],
			"rules": {
				"no-restricted-globals": "off"
			}
		},
		{
			"files": [
				"src/state/walletConnectionRuntime.spec.ts",
				"src/state/wallets/adapters/walletStandard.ts"
			],
			"rules": {
				"typescript/no-restricted-types": "off"
			}
		},
		{
			"files": [
				"src/state/wallets/adapters/aptosAip62.spec.ts",
				"src/state/wallets/adapters/eip6963.spec.ts",
				"src/state/wallets/walletConnectionSurface.ts"
			],
			"rules": {
				"typescript/consistent-type-assertions": "off"
			}
		},
		{
			"files": [
				"src/state/wallets/adapters/eip6963.spec.ts"
			],
			"rules": {
				"typescript/no-restricted-types": "off"
			}
		},
		{
			"files": [
				"src/lib/**/*.ts"
			],
			"rules": {
				"typescript/no-restricted-types": "off",
				"typescript/consistent-type-assertions": "off"
			}
		},
		{
			"files": [
				"src/lib/svelte/RemoteResource.svelte.ts"
			],
			"rules": {
				"typescript/consistent-type-assertions": "off",
				"no-restricted-globals": "off"
			}
		},
		{
			"files": [
				"src/components/Boundary.svelte",
				"src/components/QueryBoundary.svelte",
				"src/components/ResourceBoundary.svelte",
				"src/components/Tooltip.svelte"
			],
			"rules": {
				"typescript/no-restricted-types": "off",
				"typescript/consistent-type-assertions": "off"
			}
		},
		{
			"files": [
				"src/params/**/*.ts",
				"src/typescript/DecodedCalldata.ts",
				"src/views/*.svelte"
			],
			"rules": {
				"typescript/consistent-type-assertions": "off",
				"typescript/no-restricted-types": "off"
			}
		},
		{
			"files": [
				"src/routes/api/e2e/**/*.ts"
			],
			"rules": {
				"typescript/consistent-type-assertions": "off",
				"typescript/no-restricted-types": "off"
			}
		},
		{
			"files": [
				"src/constants/**/*.ts"
			],
			"rules": {
				"typescript/no-restricted-types": "off"
			}
		},
		{
			"files": [
				"src/state/wallets/adapters/eip1193.ts",
				"src/**/*.svelte",
				"src/**/*.svelte.ts",
				"src/resolvers/**/*.ts",
				"src/sources/**/*.ts",
				"src/collections/**/*.ts",
				"src/lib/**/*.ts",
				"src/constants/**/*.ts",
				"src/routes/**/*.ts",
				"src/typescript/JsonValue.ts",
				"src/state/wallets/walletConnectionState.ts",
				"src/state/wallets/walletConnectionSurface.ts",
				"src/state/wallets/adapters/aptosAip62.ts",
				"src/state/wallets/adapters/bitcoinInjected.ts",
				"src/state/wallets/adapters/walletConnectV2.ts",
				"src/state/wallets/adapters/walletStandard.ts",
				"tests/**/*.ts"
			],
			"rules": {
				"no-runtime-shape-guards/guards": "off"
			}
		}
	]
}
