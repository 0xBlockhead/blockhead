# =============================================================================
# Blockhead monorepo — consolidated env registry (blockhead, blockhead-2026,
# blockhead.vision-portfolio). PUBLIC_* keys are browser-visible; unprefixed
# runtime secrets remain server-only.
#
# Setup: cp .env.example .env.local  →  fill values  →  pnpm run env:encrypt
# Never commit .env.keys. Encrypted .env.local stays gitignored by default.
#
# dotenvx (matches ethglobal-hackmoney-2026 pattern): pnpm run env:encrypt /
# env:decrypt. Run dev/build via package.json scripts so vars load from .env.local.
# =============================================================================

# --- blockhead-2026 (Vite import.meta.env) ---

# Vite (optional dev server hosts allowlist)
VITE_DEV_ALLOWED_HOSTS=

# Optional demo RPC for +page.svelte / hooks (full URL).
PUBLIC_ETH_RPC_URL=

# Etherscan API V2 — single key for all supported chains (`apikey` query); https://etherscan.io/apidashboard
PUBLIC_ETHERSCAN_API_KEY=

# Allium — X-API-KEY (https://app.allium.so/join)
PUBLIC_ALLIUM_API_KEY=

# CoinGecko — demo: x-cg-demo-api-key; pro: x-cg-pro-api-key (https://docs.coingecko.com)
PUBLIC_COINGECKO_DEMO_API_KEY=
PUBLIC_COINGECKO_PRO_API_KEY=

# CoinMarketCap (https://coinmarketcap.com/api/)
PUBLIC_COINMARKETCAP_API_KEY=

# Coinpaprika (optional; https://coinpaprika.com/api/)
PUBLIC_COINPAPRIKA_API_KEY=

# Dune — X-DUNE-API-KEY (https://dune.com/settings/api)
PUBLIC_DUNE_API_KEY=

# Neynar — x-api-key (https://dev.neynar.com)
PUBLIC_NEYNAR_API_KEY=

# Mastodon API v1 — optional bearer (higher rate limits). Default instance: `src/constants/Mastodon.ts` → `Mastodon_Rest`
PUBLIC_MASTODON_ACCESS_TOKEN=

# Hey Lens GraphQL — optional x-lens-app for fallback Lens API rate limits (https://api.hey.xyz/graphql → api-v2.lens.dev/graphql)
PUBLIC_LENS_HEY_API_KEY=

# X — OAuth2 app bearer for api.x.com REST (https://developer.x.com/) — enables `X_Rest` when set
PUBLIC_X_API_BEARER=

# Reddit — server-only application OAuth for oauth.reddit.com REST (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# The Graph decentralized network gateway (https://thegraph.com/docs/en/subgraphs/querying/from-an-application/)
THEGRAPH_API_KEY=


# --- blockhead (legacy explorer) — RPC / wallet / indexers ---

# Airstack — GraphQL authorization header value
PUBLIC_AIRSTACK_API_KEY=

# Alchemy (per-chain keys as used in networkProviders)
PUBLIC_ALCHEMY_API_KEY_1=
PUBLIC_ALCHEMY_API_KEY_4=
PUBLIC_ALCHEMY_API_KEY_10=
PUBLIC_ALCHEMY_API_KEY_137=
PUBLIC_ALCHEMY_API_KEY_420=
PUBLIC_ALCHEMY_API_KEY_42161=
PUBLIC_ALCHEMY_API_KEY_80001=
PUBLIC_ALCHEMY_API_KEY_11155111=

# Audius
PUBLIC_AUDIUS_APP_NAME=

# Beryx / Filecoin — Bearer
PUBLIC_BERYX_API_KEY=

# Blast
PUBLIC_BLAST_PROJECT_ID=

# Blockfrost — server-side project_id header
BLOCKFROST_PROJECT_ID=

# Cardanoscan — server-side apiKey header
CARDANOSCAN_API_KEY=

# Chainbase
PUBLIC_CHAINBASE_API_KEY=

# CoinAPI — X-CoinAPI-Key
PUBLIC_COINAPI_MARKETDATA_API_KEY=

# Covalent / GoldRush — Bearer
COVALENT_API_KEY=

# Curvegrid MultiBaas
PUBLIC_CURVEGRID_MULTIBAAS_DEPLOYMENT_HOSTNAME=
PUBLIC_CURVEGRID_MULTIBAAS_API_KEY=

# Decommas
PUBLIC_DECOMMAS_API_KEY=

# Disco — Bearer
PUBLIC_DISCO_API_KEY=

# Envio
ENVIO_API_TOKEN=

# Figment DataHub
PUBLIC_FIGMENT_DATA_HUB_APP_API_KEY=

# Gateway.fm regional
PUBLIC_GATEWAY_FM_API_KEY_EU_NORTH_1=
PUBLIC_GATEWAY_FM_API_KEY_EU_CENTRAL_2=
PUBLIC_GATEWAY_FM_API_KEY_AP_SOUTHEAST_1=

# GetBlock
GETBLOCK_API_KEY=

# Infura — URL segment is project id (code uses PUBLIC_INFURA_API_KEY; .env.example historically said PROJECT_ID)
PUBLIC_INFURA_API_KEY=
PUBLIC_INFURA_API_KEY_SECRET=
# Alias / dashboard copy-paste (same value as PUBLIC_INFURA_API_KEY if you use one project)
PUBLIC_INFURA_PROJECT_ID=
PUBLIC_INFURA_PROJECT_SECRET=

# Intuition — x-api-key
PUBLIC_INTUITION_API_KEY=

# Moralis
PUBLIC_MORALIS_GATEWAY_ID=
PUBLIC_MORALIS_WEB3_API_KEY=

# Nexandria — API-Key header
PUBLIC_NEXANDRIA_API_KEY=

# NFTPort — Authorization header value
PUBLIC_NFTPORT_API_KEY=

# Noves — apiKey header
PUBLIC_NOVES_API_KEY=

# 1inch — Bearer (portal.1inch.dev)
PUBLIC_ONEINCH_API_KEY=

# Pinata
PUBLIC_PINATA_API_KEY=
PUBLIC_PINATA_API_SECRET=
PUBLIC_PINATA_JWT=

# Pocket Network
PUBLIC_POCKET_NETWORK_PORTAL_ID=
PUBLIC_POCKET_APP_PUBLIC_KEY=
PUBLIC_POCKET_NETWORK_SECRET_KEY=

# Space and Time
PUBLIC_SPACEANDTIME_ACCESS_TOKEN=
PUBLIC_SPACEANDTIME_GATEWAY_API_KEY=

# QuickNode — https://{PUBLIC_QUICKNODE_ENDPOINT_NAME}.quiknode.pro/{token}
PUBLIC_QUICKNODE_ENDPOINT_NAME=
PUBLIC_QUICKNODE_ENDPOINT_AUTHENTICATION_TOKEN=

# Tenderly — REST + Web3 Gateway
PUBLIC_TENDERLY_USER=
PUBLIC_TENDERLY_PROJECT=
PUBLIC_TENDERLY_ACCESS_TOKEN=
PUBLIC_TENDERLY_WEB3_GATEWAY_API_KEY=

# WalletConnect v1/v2
PUBLIC_WALLETCONNECT1_BRIDGE_URI=
PUBLIC_WALLETCONNECT2_PROJECT_ID=
PUBLIC_WALLETCONNECT2_RELAY_URL=

# Web3Auth / Torus
PUBLIC_TORUS_PROJECT_ID=
PUBLIC_TORUS_OPENLOGIN_SECRET=

# Zapper — api_key query or Basic(api_key)
PUBLIC_ZAPPER_API_KEY=

# Zerion — Basic authorization
PUBLIC_ZERION_API_KEY=


# --- blockhead.vision-portfolio ($env/static/private → use PUBLIC_* here) ---

# Alchemy (private in vision-portfolio → same key name pattern as above or single key)
PUBLIC_ALCHEMY_API_KEY=

# Octav — Bearer / token used as OCTAV_AUTH_TOKEN in vision-portfolio
PUBLIC_OCTAV_AUTH_TOKEN=

# The Graph Studio Amp auth (vision / hackmoney: THEGRAPH_AMP_AUTH_TOKEN)
PUBLIC_THEGRAPH_AMP_AUTH_TOKEN=


# --- Playwright e2e (Node only; playwright.config.ts + tests/playwright.env.ts) ---
# PLAYWRIGHT_HEADLESS=1
# PLAYWRIGHT_COLOR_SCHEME=dark
# PLAYWRIGHT_REDUCED_MOTION=reduce
# PLAYWRIGHT_BASE_URL=http://localhost:5173
# PLAYWRIGHT_SKIP_WEBSERVER=1

# --- ethglobal-hackmoney-2026 (sibling clone; optional in blockhead-2026) ---

PUBLIC_BLOCKSCOUT_API_KEY=
PUBLIC_CIRCLE_API_KEY=
PUBLIC_LASSO_LOCAL_HOST=
PUBLIC_LASSO_PUBLIC_API_KEY=
PUBLIC_OPENCODE_API_KEY=
PUBLIC_PARTYKIT_HOST=
PUBLIC_UNISWAP_API_KEY=
PUBLIC_VENICE_API_KEY=
