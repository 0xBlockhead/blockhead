		"arkregex": "^0.0.5",
		"arktype": "^2.2.0",
		"bits-ui": "^2.16.5",
		"devalue": "^5.6.2",
		"gql.tada": "^1.9.2",
		"graphql": "^16.13.2",
		"map.prototype.getorinsertcomputed": "^1.0.1",
		"weakmap.prototype.getorinsertcomputed": "^1.0.0"
	}
